# Import JSON is intentionally versionable/reviewable. Large binary source assets
# are ignored by default; use Git LFS/artifact storage if they must be versioned.
data/import/generic_solutions/assets/**/*
!data/import/generic_solutions/assets/**/
!data/import/generic_solutions/assets/**/.gitkeep
data/import/manufacturer_solutions/assets/**/*
!data/import/manufacturer_solutions/assets/**/
!data/import/manufacturer_solutions/assets/**/.gitkeep
